---
import StatusBadge from './StatusBadge.astro';
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<article class="project-card" data-project-card data-tags={project.data.tags.join(' ')}>
  <StatusBadge status={project.data.status} />
  <h3><a href={`${base}projects/${project.data.slug}/`}>{project.data.title}</a></h3>
  <p>{project.data.summary}</p>
  <div class="tag-list" aria-label="Project tags">
    {project.data.tags.map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <div class="card-bottom">
    <a class="text-link" href={`${base}projects/${project.data.slug}/`}>Case study →</a>
    {project.data.liveUrl && <a class="repo-link" href={project.data.liveUrl} target="_blank" rel="noopener noreferrer">Live ↗</a>}
    {project.data.repoUrl && <a class="repo-link" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
  </div>
</article>
