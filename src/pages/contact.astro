---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Contact" description="Contact links for this pseudonymous engineering portfolio.">
  <div class="container">
    <header class="page-title">
      <p class="section-kicker">ST*50 · Contact</p>
      <h1>Contact</h1>
      <p>This portfolio is intentionally anonymous. Use GitHub for project-related contact.</p>
    </header>
    <section class="page-section">
      <div class="link-row">
        <a class="text-link" href="https://github.com/curburenthusiasm" target="_blank" rel="noopener noreferrer">GitHub profile ↗</a>
        <span class="date-line">Email: {'{CONTACT_EMAIL}'}</span>
      </div>
    </section>
  </div>
</SiteLayout>
