---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="About" description="Background, focus areas, and design principles for an engineering portfolio spanning automation, ERP/EDI, data, AI agents, and research.">
  <div class="container">
    <header class="page-title">
      <p class="section-kicker">ST*40 · About</p>
      <h1>Build systems that can explain themselves.</h1>
      <p>IT and automation leadership across ERP/EDI integration, SQL and BI, agentic systems, infrastructure, operational controls, and applied research—with a bias toward practical automation and auditable design.</p>
    </header>
    <section class="page-section">
      <h2 class="section-heading">Focus areas</h2>
      <div class="principle-grid">
        <article class="principle"><h3>Enterprise automation</h3><p>ERP, EDI, shipping, workforce, and reporting workflows that remove repetitive handoffs while surfacing exceptions.</p></article>
        <article class="principle"><h3>Operational data</h3><p>SQL-backed analytics, inventory reconstruction, and reporting systems with traceable transformations.</p></article>
        <article class="principle"><h3>Agentic systems</h3><p>Persistent context, specialized agents, evaluation, and guarded write actions for useful bounded autonomy.</p></article>
        <article class="principle"><h3>Applied research</h3><p>Quantitative, security, cryptographic, and machine-learning experiments with explicit separation between targets and demonstrated results.</p></article>
      </div>
    </section>
    <section class="page-section">
      <h2 class="section-heading">Toolbox</h2>
      <p class="section-desc">Examples drawn from the work described here; not every tool appears in every project.</p>
      <div class="stack-list">
        {['Python', 'SQL Server', 'SQL Server Agent', 'Power BI', 'Sage 100', 'X12 EDI', 'Orderful', 'Tray.io', 'ShipStation', 'OpenClaw', 'MCP', 'REST APIs', 'TypeScript', 'Supabase', 'Proxmox', 'Ceph'].map((tool) => <span class="stack-item">{tool}</span>)}
      </div>
      <p class="data-caveat">This portfolio intentionally omits employer, customer, partner, endpoint, credential, and other private implementation details. Public case studies focus on architecture, engineering choices, and verifiable outcomes.</p>
    </section>
    <p class="link-row"><a class="text-link" href={`${base}projects/`}>Browse case studies →</a><a class="text-link" href={`${base}contact/`}>Contact →</a></p>
  </div>
</SiteLayout>
