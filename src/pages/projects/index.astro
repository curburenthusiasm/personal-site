---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const tags = [...new Set(projects.flatMap((project) => project.data.tags))].sort();
---
<SiteLayout title="Projects" description="Case studies in enterprise automation, ERP/EDI, operational data, agentic systems, infrastructure, products, quantitative tooling, and applied research.">
  <div class="wide-container">
    <header class="page-title">
      <p class="section-kicker">ST*10 · Portfolio</p>
      <h1>Projects</h1>
      <p>Production systems, prototypes, products, and research. Each case study states its status and focuses on the problem, constraints, architecture, results, and lessons without exposing private operational details.</p>
    </header>
    <div class="filters" aria-label="Filter projects by tag">
      <button class="filter-button" type="button" data-filter="all" aria-pressed="true">All</button>
      {tags.map((tag) => <button class="filter-button" type="button" data-filter={tag} aria-pressed="false">{tag}</button>)}
    </div>
    <div class="card-grid" id="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-filter]')];
      const cards = [...document.querySelectorAll('[data-project-card]')];
      buttons.forEach((button) => button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
        cards.forEach((card) => { card.hidden = filter !== 'all' && !card.dataset.tags.split(' ').includes(filter); });
      }));
    })();
  </script>
</SiteLayout>
