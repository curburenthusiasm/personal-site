---
import SiteLayout from '../layouts/SiteLayout.astro';
import MacroScoreboard from '../components/MacroScoreboard.astro';
---
<SiteLayout title="Macro thesis scoreboard" description="A source-linked Palindromic Dollar regime scoreboard with deterministic scenario weights, policy triggers, and dated macro evidence.">
  <div class="wide-container">
    <header class="page-title">
      <p class="section-kicker">ST*60 · Macro</p>
      <h1>Thesis Scoreboard</h1>
      <p>Source-linked readings feed a deterministic regime model: r0 → r1 → r2 → r3 → r2↑ → r1↑ → r0↑. Scenario weights recompute from a fixed baseline and registered zero-sum rules rather than being manually edited or treated as investment probabilities.</p>
    </header>
  </div>
  <MacroScoreboard />
</SiteLayout>
