---
import SiteLayout from '../layouts/SiteLayout.astro';
import MacroScoreboard from '../components/MacroScoreboard.astro';
---
<SiteLayout title="Macro thesis scoreboard" description="Source-linked macro readings with refreshable public feeds and dated evidence snapshots.">
  <div class="wide-container">
    <header class="page-title">
      <p class="section-kicker">ST*60 · Macro</p>
      <h1>Thesis Scoreboard</h1>
      <p>Source-linked readings and dated evidence. The page reports observations separately from fixed hypotheses; it does not turn refreshed data into investment advice.</p>
    </header>
  </div>
  <MacroScoreboard />
</SiteLayout>
