---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';

const base = import.meta.env.BASE_URL;
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((project) => project.data.featured).slice(0, 3);
const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<SiteLayout title="Engineering portfolio" description="An anonymous engineering notebook about reliable automation, evidence, and public research status.">
  <section class="hero">
    <div class="wide-container hero-grid">
      <div>
        <p class="eyebrow">Engineering notebook · Systems · Evidence</p>
        <h1>I build systems that make messy operational data <em>trustworthy.</em></h1>
        <p class="hero-subtitle">Agentic automation, EDI pipelines, governed data, and tamper-evident records—designed around falsifiable outcomes and honest status.</p>
        <div class="link-row">
          <a class="text-link" href={`${base}projects/`}>Explore projects ↓</a>
          <a class="text-link" href={`${base}notes/`}>Read field notes →</a>
        </div>
      </div>
      <aside class="hero-aside">
        <p><strong>Operating principles</strong></p>
        <p>Truth over output. Failure-first design. Judgment becomes rules. Separate research from production and read from write.</p>
      </aside>
    </div>
  </section>

  <section class="page-section" aria-labelledby="featured-title">
    <div class="wide-container">
      <div class="section-topline">
        <div>
          <p class="section-kicker">ST*01 · Selected work</p>
          <h2 class="section-heading" id="featured-title">Systems with a checkable story</h2>
          <p class="section-desc">Project status distinguishes production work, prototypes, research, concepts, and active investigations. Reported outcomes are not confused with targets or plans.</p>
        </div>
        <a class="text-link" href={`${base}projects/`}>All projects →</a>
      </div>
      <div class="card-grid">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="wide-container">
      <p class="section-kicker">ST*02 · Design themes</p>
      <h2 class="section-heading">The recurring questions</h2>
      <ul class="feature-list">
        <li><strong>Truth over output</strong>Produce a verifiable record, not merely a result.</li>
        <li><strong>Failure first</strong>Enumerate failure modes, then derive countermeasures.</li>
        <li><strong>Judgment → rules</strong>Turn one-off orchestration decisions into deterministic worker rules.</li>
        <li><strong>Blast radius</strong>Separate research from production and require approval for consequential writes.</li>
        <li><strong>SQL decides</strong>Keep business logic in governed data; let the app display it.</li>
      </ul>
    </div>
  </section>

  <section class="page-section">
    <div class="wide-container">
      <div class="section-topline">
        <div>
          <p class="section-kicker">ST*03 · Public instruments</p>
          <h2 class="section-heading">Live output, with its limits attached</h2>
          <p class="section-desc">Two refreshable pages publish source-linked macro readings and selected sports-pick outputs. Feed values are kept distinct from interpretation or performance claims.</p>
        </div>
        <div class="link-row">
          <a class="text-link" href={`${base}macro/`}>Macro scoreboard →</a>
          <a class="text-link" href={`${base}picks/`}>Sports picks →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="wide-container">
      <div class="section-topline">
        <div>
          <p class="section-kicker">ST*04 · Latest notes</p>
          <h2 class="section-heading">Recent writing</h2>
          <p class="section-desc">Only reviewed notes appear here and in the RSS feed. Drafts are excluded from public listings.</p>
        </div>
        <a class="text-link" href={`${base}notes/`}>All notes →</a>
      </div>
      <div class="note-list">
        {notes.map((note) => <NoteCard note={note} />)}
      </div>
    </div>
  </section>
</SiteLayout>
