---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<SiteLayout title="Notes" description="Reviewed engineering notes on evidence, automation, data governance, and research methodology.">
  <div class="wide-container">
    <header class="page-title">
      <p class="section-kicker">ST*30 · Field notes</p>
      <h1>Notes</h1>
      <p>Reviewed writing on operating systems, research, and the evidence required to make claims.</p>
    </header>
    <div class="note-list">{notes.map((note) => <NoteCard note={note} />)}</div>
  </div>
</SiteLayout>
